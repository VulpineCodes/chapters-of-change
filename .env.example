# Copy to .env — never commit real secrets
DATABASE_URL=postgresql://chapters:chapters@localhost:5432/chapters?schema=public
# Runtime store adapter: "memory" (default; verified in-memory adapter seeded
# with synthetic data) or "prisma" (PostgreSQL via DATABASE_URL — selectable
# but UNVERIFIED against a live database; requires `npx prisma generate`).
STORE_ADAPTER=memory
# Optional. When unset, the API boots with the BullMQ notification worker
# disabled (logged clearly; outbox events remain PENDING in the store).
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development
LOG_LEVEL=info

# ── SYNTHETIC / DEV-ONLY seeded credentials ─────────────────────────────────
# The seeded demo users (all fictional) can log in via POST /auth/login with
# these passwords in local development. They are published on purpose, are
# bcrypt-hashed at seed time, and must never be used anywhere real:
#   donor@example.com            / synthetic-donor-pass
#   admin@riverside.example.com  / synthetic-org-pass
#   member@riverside.example.com / synthetic-org-pass
#   admin@sunrise.example.com    / synthetic-org-pass
